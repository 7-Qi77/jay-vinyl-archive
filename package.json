{
  "name": "jay-vinyl-archive",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "python -m http.server 5173",
    "test:smoke": "node tests/smoke.mjs",
    "lint": "eslint js tests",
    "format": "prettier --write \"js/**/*.js\" \"tests/*.mjs\" \"index.html\" \"styles.css\"",
    "build:ios-web": "node scripts/build-ios-web.mjs",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build:ios-web && npx cap sync ios",
    "ios:assets": "npx @capacitor/assets generate --ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "eslint": "^9.12.0",
    "playwright": "^1.47.0",
    "prettier": "^3.3.3"
  }
}
