", "s": 217.62, "e": 219.04}, {"c": "刺", "s": 219.3, "e": 219.62}, {"c": "傷", "s": 219.92, "e": 220.1}, {"c": "人", "s": 220.2, "e": 220.44}, {"c": "的", "s": 220.44, "e": 220.92}, {"c": "很", "s": 220.92, "e": 221.48}, {"c": "直", "s": 221.56, "e": 221.78}, {"c": "接", "s": 221.94, "e": 222.38}]}, {"start": 224.22, "end": 231.78, "text": "過去被翻閱 結局滿天的風雪", "chars": [{"c": "過", "s": 224.22, "e": 224.42}, {"c": "去", "s": 224.64, "e": 224.98}, {"c": "被", "s": 225.04, "e": 225.18}, {"c": "翻", "s": 225.36, "e": 225.78}, {"c": "閱", "s": 225.78, "e": 226.14}, {"c": "結", "s": 226.36, "e": 227.54}, {"c": "局", "s": 227.76, "e": 227.9}, {"c": "滿", "s": 227.92, "e": 228.08}, {"c": "天", "s": 228.3, "e": 228.98}, {"c": "的", "s": 228.98, "e": 229.88}, {"c": "風", "s": 230.34, "e": 230.72}, {"c": "雪", "s": 231.04, "e": 231.78}]}]}